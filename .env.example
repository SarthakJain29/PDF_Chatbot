# All optional. With no keys the app runs in mock (demo) mode.
# LLM_PROVIDER=auto|gemini|groq|mock   (default auto: gemini -> groq -> mock)
LLM_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
