
PORT=5000

# Frontend URL (for CORS and API calls)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Firebase Client Config (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# MongoDB connection string

MONGODB_URI=mongodb://localhost:27017/rag_chatbot

# MongoDB database name (optional, can be in URI)
MONGODB_DB_NAME=rag_chatbot

#
# LLM / AI Model APIs

OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (e.g., gpt-4, gpt-4-turbo, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4-turbo-preview

# Alternative: Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# Vector Database / Embeddings
# ============================================
# OpenAI Embeddings API (for generating embeddings)
# Uses the same OPENAI_API_KEY above

# Embedding model (e.g., text-embedding-3-large, text-embedding-ada-002)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Embedding dimensions (1536 for text-embedding-3-large, 3072 for text-embedding-3-large with higher dimensions)
EMBEDDING_DIMENSIONS=1536

# ============================================
# Application Environment

NODE_ENV=development
