{
  "name": "@my-scope/shared",
  "version": "0.0.0",
  "private": true,
  "files": [
    ".dist"
  ],
  "exports": {
    "./constants": {
      "types": "./.dist/constants/index.d.ts",
      "require": "./.dist/constants/index.js",
      "import": "./.dist/constants/index.mjs"
    },
    "./types": {
      "types": "./.dist/types/index.d.ts",
      "require": "./.dist/types/index.js",
      "import": "./.dist/types/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup constants/index.ts types/index.ts --format cjs,esm --dts --out-dir .dist --clean",
    "dev": "bun run build && tsup constants/index.ts types/index.ts --format cjs,esm --dts --out-dir .dist --watch",
    "start": "echo 'No start needed'",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .dist .turbo"
  },
  "devDependencies": {
    "@my-scope/eslint-config": "*",
    "@my-scope/typescript-config": "*",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
