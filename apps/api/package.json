{
  "name": "@my-scope/api",
  "version": "0.0.0",
  "private": true,
  "main": ".dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --out-dir .dist",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node .dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .dist .turbo"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.5",
    "@my-scope/db": "*",
    "@my-scope/shared": "*",
    "ai": "^3.4.33",
    "colors": "^1.4.0",
    "cloudinary": "^2.5.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-fileupload": "^1.5.2",
    "morgan": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.530",
    "zod": "^3.23.8",
    "zod-error": "^1.2.0"
  },
  "devDependencies": {
    "@my-scope/eslint-config": "*",
    "@my-scope/typescript-config": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.4.4",
    "@types/node": "^20.14.0",
    "@types/morgan": "^1.9.9",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
