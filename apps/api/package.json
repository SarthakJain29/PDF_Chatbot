{
  "name": "@my-scope/api",
  "version": "0.0.0",
  "private": true,
  "main": ".dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --out-dir .dist",
    "dev": "bun --watch src/index.ts",
    "start": "node .dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .dist .turbo"
  },
  "dependencies": {
    "@my-scope/shared": "*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@my-scope/eslint-config": "*",
    "@my-scope/typescript-config": "*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
